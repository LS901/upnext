# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Local Supabase values come from `npx supabase status` after `npx supabase start`.

# Public: inlined into the browser bundle at build time. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (INV-005). Never add a NEXT_PUBLIC_ prefix to these, and never
# import code that reads them from a client component.
# Supabase service-role / secret key: bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# TMDB API read access token (movies and TV).
TMDB_API_READ_ACCESS_TOKEN=
# Twitch app credentials for IGDB (games).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Hardcover API token (books). Sent as `Authorization: Bearer <token>`; a value
# that already starts with "Bearer " is accepted too.
HARDCOVER_API_TOKEN=
# Shared secret for POST /api/cron/refresh (the scheduler and `npm run refresh`
# send it as `Authorization: Bearer <secret>`). Any long random string.
CRON_SECRET=

# Optional provider base URLs, for pointing tests at a stub. Defaults shown.
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
# IGDB_API_BASE_URL=https://api.igdb.com/v4
# TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
# HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql
# Test-only (e2e): how long a Hardcover search may wait for its turn, in ms. Default 3000.
# HARDCOVER_SEARCH_MAX_WAIT_MS=
